@startuml
title Cuidados-Pet — Diagrama de Classes
left to right direction
skinparam classAttributeIconSize 0

class Veterinario {
  - id: int
  - nome: String
  - telefone: String
  - email: String
  - endereco: String
  - especialidade: String
}

class Tutor {
  - id: int
  - nome: String
  - telefone: String
  - email: String
  - endereco: String
}

class Animal {
  - id: int
  - nome: String
  - especie: String
  - raca: String
  - idade: int
  - peso: float
  - nomeTutor: String
}

class Consulta {
  - id: int
  - data: Date
  - nomeAnimal: String
  - nomeVeterinario: String
  - motivo: String
  - valor: float
}

' Associações conceituais indicadas pelos campos de referência
Tutor "1" -- "1*" Animal : responsável por
Animal "1" -- "0..*" Consulta : recebe
Veterinario "1" -- "0..*" Consulta : realiza

@enduml
